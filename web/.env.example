# Copia este archivo a .env.local (en tu ordenador) o pon estas variables en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (usa las de "Test mode" primero)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Solo para pruebas sin Razorpay: confirma compras sin cobrar. Quitar antes de vender de verdad.
PAYMENTS_DEMO=false

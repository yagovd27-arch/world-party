# Copia este archivo a .env.local (en tu ordenador) o pon estas variables en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay → Account & Settings → API Keys (usa las de "Test mode" primero)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Solo para pruebas sin Razorpay: confirma compras sin cobrar. Quitar antes de vender de verdad.
PAYMENTS_DEMO=false

# Entradas por email (Resend → API Keys). Sin esto no se envían emails.
RESEND_API_KEY=
# Opcional: remitente (dominio verificado en Resend)
EMAIL_FROM="la nit <hola@lanit.club>"

# Cobro manual por UPI mientras no haya Razorpay. Vacío = apagado.
UPI_VPA=
UPI_NAME="la nit"
